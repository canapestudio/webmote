---
import { htmlLang, otherLang, pagePath, useTranslations, type Lang, type PageKey } from '../i18n';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  page?: PageKey;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);
const home = pagePath(lang, '');
const other = otherLang(lang);
const switchHref = pagePath(other, page ?? '');
const links = [
  { href: `${home}#features`, label: t.nav.features },
  { href: `${home}#privacy`, label: t.nav.privacy },
  { href: `${home}#faq`, label: t.nav.faq },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href={home} aria-label={t.nav.home}>
      <Logo size={36} />
      <span aria-hidden="true">Webmote</span>
    </a>
    <nav class="header__nav" aria-label={t.nav.label}>
      <ul>
        {
          links.map((link) => (
            <li class="header__section-link">
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a class="header__lang" href={switchHref} hreflang={htmlLang[other]} lang={htmlLang[other]}>
            <Icon name="globe" />
            <span class="header__lang-long">{t.nav.switchTo}</span>
            <span class="header__lang-short" aria-hidden="true">{t.nav.switchToShort}</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    backdrop-filter: saturate(1.6) blur(16px);
    border-bottom: 1px solid transparent;
  }

  /* A hairline fades in once the page scrolls (CSS scroll timeline, no script). */
  @supports (animation-timeline: scroll()) {
    .header {
      animation: header-line linear both;
      animation-timeline: scroll();
      animation-range: 0 96px;
    }
  }

  @keyframes header-line {
    to {
      border-bottom-color: var(--line);
      box-shadow: 0 10px 30px -18px rgb(30 42 68 / 0.25);
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-start: -0.25rem;
    padding: 0.25rem;
    border-radius: 14px;
    color: var(--ink);
    font-size: 1.3125rem;
    font-weight: 720;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .header__nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border-radius: 12px;
    color: var(--ink);
    font-size: 0.9875rem;
    font-weight: 560;
    text-decoration: none;
    transition: background-color 0.2s var(--ease-out);
  }

  .header__nav a:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .header__lang {
    margin-inline-start: 0.5rem;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .header__nav a.header__lang:hover {
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .header__lang :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--muted);
  }

  .header__lang-short {
    display: none;
  }

  @media (max-width: 720px) {
    .header__section-link {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .header__lang-long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .header__lang-short {
      display: inline;
    }
  }
</style>
