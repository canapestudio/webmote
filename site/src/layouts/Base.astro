---
import '@fontsource-variable/roboto/wght.css';
import '../styles/global.css';
import robotoLatin from '@fontsource-variable/roboto/files/roboto-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import { htmlLang, languages, pagePath, useTranslations, type Lang, type PageKey } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import featureGraphicEn from '../assets/brand/feature-graphic-en.png';
import featureGraphicFr from '../assets/brand/feature-graphic-fr.png';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Set for pages that exist in both languages: adds hreflang alternates and the language switch. */
  page?: PageKey;
  noindex?: boolean;
}

const { lang, title, description, page, noindex = false } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;

const og = await getImage({
  src: lang === 'fr' ? featureGraphicFr : featureGraphicEn,
  format: 'jpg',
  quality: 88,
});
const ogImage = new URL(og.src, site).href;
const otherOgLocale = lang === 'fr' ? 'en_US' : 'fr_FR';
---

<!doctype html>
<html lang={htmlLang[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      page !== undefined &&
        languages.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(pagePath(l, page), site).href} />)
    }
    {page !== undefined && <link rel="alternate" hreflang="x-default" href={new URL(pagePath('en', page), site).href} />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f7fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1220" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="no-referrer" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={robotoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Webmote" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {page !== undefined && <meta property="og:locale:alternate" content={otherOgLocale} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
  </body>
</html>
