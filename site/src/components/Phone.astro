---
/**
 * A real app screenshot (1080 × 1920) in a phone frame drawn in CSS: no third-party mockup.
 * The frame scales with `--pw` (its width), which the parent sets; `sizes` must describe the same width.
 */
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { src, alt, sizes, priority = false, class: className } = Astro.props;
---

<div class:list={['phone', className]}>
  <Picture
    src={src}
    alt={alt}
    widths={[260, 360, 480, 640, 800, 1080]}
    sizes={sizes}
    formats={['avif', 'webp']}
    quality={80}
    priority={priority}
  />
</div>

<style>
  .phone {
    --pw: 280px;
    --bezel: calc(var(--pw) * 0.034);
    position: relative;
    flex: none;
    width: var(--pw);
    padding: var(--bezel);
    border-radius: calc(var(--pw) * 0.105);
    background: linear-gradient(160deg, #2b3552 0%, #121829 32%, #0b0f1b 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.16),
      inset 0 0 0 calc(var(--bezel) * 0.45) #0a0e18,
      0 0 0 1px rgb(10 14 24 / 0.6),
      var(--shadow-phone);
  }

  /* Volume rocker and power key on the right edge. */
  .phone::before,
  .phone::after {
    content: '';
    position: absolute;
    right: calc(var(--pw) * -0.011);
    width: calc(var(--pw) * 0.011 + 1px);
    border-radius: 0 3px 3px 0;
    background: linear-gradient(90deg, #1a2136, #3a4462);
  }

  .phone::before {
    top: 19%;
    height: 7%;
  }

  .phone::after {
    top: 29%;
    height: 13%;
  }

  .phone :global(picture) {
    position: relative;
  }

  .phone :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1080 / 1920;
    /* Small enough that the screenshot's status-bar clock stays clear of the corner. */
    border-radius: calc(var(--pw) * 0.068);
    background: #f7f7fc;
  }

  /* Front camera, centred in the status bar. */
  .phone :global(picture)::after {
    content: '';
    position: absolute;
    top: 1.15%;
    left: 50%;
    width: 4.2%;
    aspect-ratio: 1;
    border-radius: 50%;
    translate: -50% 0;
    background: radial-gradient(circle at 35% 35%, #2a3350 0 18%, #05070d 45%);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.35);
  }
</style>
