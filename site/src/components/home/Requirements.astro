---
import { useTranslations, type Lang } from '../../i18n';
import Icon, { type IconName } from '../Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const r = t.requirements;
---

<section class="section" id="requirements" aria-labelledby="requirements-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="kicker">{r.kicker}</p>
      <h2 id="requirements-title" class="h2">{r.title}</h2>
    </div>

    <ul class="needs reveal">
      {
        r.items.map((item) => (
          <li>
            <span class="icon-tile">
              <Icon name={item.icon as IconName} />
            </span>
            <h3 class="h3">{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="card wake reveal">
      <div class="wake__intro">
        <h3 class="h3">
          <Icon name="power" />
          {r.wakeTitle}
        </h3>
        <p>{r.wakeIntro}</p>
      </div>
      <dl class="wake__list">
        {
          r.wake.map((step) => (
            <div class="wake__row">
              <dt>{step.model}</dt>
              <dd>
                <span class="wake__action">{step.action}</span>
                <span class="wake__path">
                  <span class="visually-hidden">{r.pathLabel}: </span>
                  {step.path.map((part, i) => (
                    <>
                      {i > 0 && (
                        <span class="wake__sep" aria-hidden="true">
                          ›
                        </span>
                      )}
                      <span class="wake__crumb">{part}</span>
                    </>
                  ))}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <p class="languages reveal">
      <Icon name="globe" />
      {r.languages}
    </p>
  </div>
</section>

<style>
  .needs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 2rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    list-style: none;
  }

  .needs h3 {
    margin-top: 1rem;
  }

  .needs p {
    margin-top: 0.25rem;
    color: var(--muted);
  }

  .wake {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 1.5rem 3rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .wake__intro h3 {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .wake__intro h3 :global(svg) {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    color: var(--accent);
  }

  .wake__intro p {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .wake__list {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .wake__row {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }

  .wake__row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .wake__row dt {
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 560;
  }

  .wake__row dd {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .wake__action {
    color: var(--ink);
    font-weight: 600;
  }

  .wake__path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
  }

  .wake__crumb {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
    font-weight: 500;
  }

  .wake__sep {
    color: var(--muted);
  }

  .languages {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 2rem;
    color: var(--muted);
  }

  .languages :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (max-width: 859px) {
    .wake {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .wake__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
