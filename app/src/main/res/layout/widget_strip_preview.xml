<?xml version="1.0" encoding="utf-8"?>
<!-- What the 4×1 strip looks like, for the widget picker on Android 12+. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_widget_preview_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_strip_label"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/ic_widget_preview_button"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_widget_power"
        android:tint="?android:attr/textColorPrimary" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/ic_widget_preview_button"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_widget_volume_down"
        android:tint="?android:attr/textColorPrimary" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/ic_widget_preview_button"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_widget_mute"
        android:tint="?android:attr/textColorPrimary" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/ic_widget_preview_button"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_widget_volume_up"
        android:tint="?android:attr/textColorPrimary" />
</LinearLayout>
