  dpad: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2"/><path d="M10.8 6.3L12 5.1l1.2 1.2M10.8 17.7l1.2 1.2 1.2-1.2M6.3 10.8L5.1 12l1.2 1.2M17.7 10.8l1.2 1.2-1.2 1.2"/>',
  brightness:
    '<circle cx="12" cy="12" r="3.8"/><path d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M5.5 18.5l1.4-1.4M17.1 6.9l1.4-1.4"/>',
